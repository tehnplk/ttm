DROP TABLE IF EXISTS `StaffSchedule`;
CREATE TABLE `StaffSchedule`  (
  `id` int NOT NULL AUTO_INCREMENT,
  `staff_id` varchar(191) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL,
  `offDays` varchar(191) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL,
  `busySlots` varchar(191) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL,
  `created_at` datetime NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` datetime NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`) USING BTREE,
  UNIQUE INDEX `StaffSchedule_staffId_key`(`staff_id` ASC) USING BTREE,
  INDEX `StaffSchedule_staffId_fkey`(`staff_id` ASC) USING BTREE,

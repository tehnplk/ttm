-- ----------------------------
-- Table structure for cwork_time
-- ----------------------------
DROP TABLE IF EXISTS `cwork_time`;
CREATE TABLE `cwork_time`  (
  `id` int NOT NULL AUTO_INCREMENT,
  `emp_id` int NULL DEFAULT NULL,
  `work_date` date NULL DEFAULT NULL,
  `begin_time` time NULL DEFAULT NULL,
  `is_active` enum('yes','no') CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NULL DEFAULT NULL,
  PRIMARY KEY (`id`) USING BTREE
) ENGINE = InnoDB AUTO_INCREMENT = 1 CHARACTER SET = utf8mb3 COLLATE = utf8mb3_general_ci ROW_FORMAT = DYNAMIC;

-- ----------------------------
-- Records of cwork_time
-- ----------------------------

-- ----------------------------
-- Table structure for emp_stop_date
-- ----------------------------
DROP TABLE IF EXISTS `emp_stop_date`;
CREATE TABLE `emp_stop_date`  (
  `emp_id` int NOT NULL,
  `stop_date` date NOT NULL,
  PRIMARY KEY (`emp_id`, `stop_date`) USING BTREE
) ENGINE = InnoDB CHARACTER SET = utf8mb3 COLLATE = utf8mb3_general_ci ROW_FORMAT = Dynamic;


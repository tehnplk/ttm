-- ----------------------------
-- Table structure for broadcast_settings
-- ----------------------------
DROP TABLE IF EXISTS `broadcast_settings`;
CREATE TABLE `broadcast_settings`  (
  `id` int NOT NULL AUTO_INCREMENT,
  `broadcast_date` date NOT NULL COMMENT 'วันที่ส่ง',
  `broadcast_time` varchar(5) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'เวลาส่ง (HH:mm)',
  `message` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'ข้อความที่ส่ง',
  `enabled` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NULL DEFAULT 'yes' COMMENT 'เปิด/ปิดการส่ง',
  `sent` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NULL DEFAULT 'no' COMMENT 'สถานะการส่ง (yes/no)',
  `sent_at` datetime NULL DEFAULT NULL COMMENT 'เวลาที่ส่งจริง',
  `created_at` datetime NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` datetime NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  `branch_ids` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NULL COMMENT 'JSON array of branch IDs to send broadcast to',
  PRIMARY KEY (`id`) USING BTREE,
  INDEX `idx_broadcast_date`(`broadcast_date` ASC) USING BTREE,
  INDEX `idx_broadcast_datetime`(`broadcast_date` ASC, `broadcast_time` ASC) USING BTREE,
  INDEX `idx_enabled_sent`(`enabled` ASC, `sent` ASC) USING BTREE
) ENGINE = InnoDB AUTO_INCREMENT = 4 CHARACTER SET = utf8mb4 COLLATE = utf8mb4_unicode_ci ROW_FORMAT = Dynamic;


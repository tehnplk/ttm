-- ----------------------------
-- Table structure for faq
-- ----------------------------
DROP TABLE IF EXISTS `faq`;
CREATE TABLE `faq`  (
  `id` int NOT NULL AUTO_INCREMENT,
  `question` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'คำถาม',
  `answer` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'คำตอบ',
  `order` int NULL DEFAULT 0 COMMENT 'ลำดับการแสดงผล',
  `is_active` varchar(10) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NULL DEFAULT 'yes' COMMENT 'สถานะ (yes/no)',
  `created_at` datetime NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` datetime NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`) USING BTREE,
  INDEX `idx_order`(`order` ASC) USING BTREE,
  INDEX `idx_is_active`(`is_active` ASC) USING BTREE
) ENGINE = InnoDB AUTO_INCREMENT = 6 CHARACTER SET = utf8mb4 COLLATE = utf8mb4_unicode_ci COMMENT = 'ตารางคำถามพบบ่อย' ROW_FORMAT = Dynamic;

-- ----------------------------
-- Records of faq
-- ----------------------------
INSERT INTO `faq` VALUES (1, 'test', 'xxxxxxx', 1, 'no', '2025-12-12 10:53:44', '2025-12-12 10:58:09');
INSERT INTO `faq` VALUES (2, 'วิธีการจองคิว?', '1. คลิกปุ่ม \"จองคิว\" เพื่อเข้าสู่ระบบจองคิว\n2. เลือกวันที่และเวลาที่ต้องการ\n3. เลือกพนักงานนวดที่ต้องการ\n4. กรอกข้อมูลส่วนตัว\n5. ยืนยันการจอง', 1, 'yes', '2025-12-12 10:57:57', '2025-12-12 10:57:57');
INSERT INTO `faq` VALUES (3, 'ดูประวัติการจองได้อย่างไร?', 'คุณสามารถดูประวัติการจองได้โดย:\n- คลิกปุ่ม \"ประวัติการจอง\" ในเมนูหลัก\n- หรือพิมพ์ \"ประวัติการจอง\" ในแชท\nระบบจะแสดงรายการจองทั้งหมดของคุณ พร้อมรายละเอียดวันที่ เวลา สาขา และพนักงาน', 2, 'yes', '2025-12-12 10:57:57', '2025-12-12 10:57:57');
INSERT INTO `faq` VALUES (4, 'ยกเลิกการจองได้หรือไม่?', 'คุณสามารถยกเลิกการจองได้โดย:\n- ติดต่อเจ้าหน้าที่เพื่อแจ้งความประสงค์ยกเลิก\n- หรือเข้าไปดูรายละเอียดการจองในประวัติการจอง\nกรุณาแจ้งล่วงหน้าก่อนวันนัดอย่างน้อย 1 วัน', 3, 'yes', '2025-12-12 10:57:57', '2025-12-12 10:57:57');
INSERT INTO `faq` VALUES (5, 'หห', 'ดหด', 0, 'no', '2025-12-12 11:13:46', '2025-12-12 11:13:49');

-- ----------------------------
-- Table structure for line_log
-- ----------------------------
DROP TABLE IF EXISTS `line_log`;
CREATE TABLE `line_log`  (
  `id` int NOT NULL AUTO_INCREMENT,
  `line_id` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NULL DEFAULT NULL,
  `line_profile` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NULL DEFAULT NULL,
  `message` varchar(1000) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NULL DEFAULT NULL,
  `do_time` datetime NULL DEFAULT NULL,
  `note1` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NULL DEFAULT NULL,
  `note2` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NULL DEFAULT NULL,
  `note3` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NULL DEFAULT NULL,
  `created_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`id`) USING BTREE
) ENGINE = InnoDB AUTO_INCREMENT = 215 CHARACTER SET = utf8mb3 COLLATE = utf8mb3_general_ci ROW_FORMAT = Dynamic;

-- ----------------------------
-- Records of line_log
-- ----------------------------

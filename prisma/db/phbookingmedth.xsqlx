-- ----------------------------
-- Table structure for broadcast_log
-- ----------------------------
DROP TABLE IF EXISTS `broadcast_log`;
CREATE TABLE `broadcast_log`  (
  `id` int NOT NULL AUTO_INCREMENT,
  `broadcast_id` int NOT NULL COMMENT 'ID จากตาราง broadcast_settings',
  `line_id` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'LINE User ID ที่ได้รับ broadcast',
  `sent_status` tinyint(1) NULL DEFAULT 1 COMMENT 'สถานะการส่ง: 1=สำเร็จ, 0=ล้มเหลว',
  `error_message` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NULL COMMENT 'ข้อความ error ถ้าส่งไม่สำเร็จ',
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT 'วันที่และเวลาที่ส่ง',
  PRIMARY KEY (`id`) USING BTREE,
  INDEX `idx_broadcast_id`(`broadcast_id` ASC) USING BTREE,
  INDEX `idx_line_id`(`line_id` ASC) USING BTREE,
  INDEX `idx_created_at`(`created_at` ASC) USING BTREE,
  INDEX `idx_broadcast_line`(`broadcast_id` ASC, `line_id` ASC) USING BTREE
) ENGINE = InnoDB AUTO_INCREMENT = 9 CHARACTER SET = utf8mb4 COLLATE = utf8mb4_unicode_ci COMMENT = 'ตารางเก็บ log การส่ง broadcast' ROW_FORMAT = Dynamic;

